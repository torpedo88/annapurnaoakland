DATABASE_URL=postgresql://user:pass@host:5432/db
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Admin panel auth ─────────────────────────────────────────────────────────
# HMAC secret for signed staff session cookies (required). Use a long random string.
STAFF_SESSION_SECRET=change-me-to-a-long-random-string
# Initial owner account, created once by `npm run db:seed:staff`.
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me

# ─── DoorDash Drive (Phase 3) ─────────────────────────────────────────────────
# Obtain from developer.doordash.com → Drive portal → API credentials
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
# Set when configuring the webhook URL in the Drive portal
DOORDASH_WEBHOOK_SECRET=

# Restaurant pickup details (used as Drive pickup origin)
RESTAURANT_PICKUP_ADDRESS=948 Clay Street, Oakland, CA 94607
RESTAURANT_PICKUP_PHONE=+15102509696

# Public base URL (used for absolute links; set to your Vercel deployment URL in production)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Address autocomplete + geofencing (Google Maps Platform) ───────────────
# Browser key (referer-restricted) — Maps JavaScript API + Places API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key (API-restricted to Geocoding) — used for the delivery radius check.
GOOGLE_GEOCODING_API_KEY=

# ─── Email (Twilio SendGrid) — off until SENDGRID_API_KEY is set ─────────────
# SendGrid API key (Mail Send). Sender domain must be authenticated in SendGrid.
SENDGRID_API_KEY=
EMAIL_FROM=Annapurna Oakland <orders@yourdomain.com>
RESTAURANT_NOTIFY_EMAIL=kitchen@yourdomain.com

# ─── SMS (Twilio) — optional, off until set ──────────────────────────────────
# TWILIO_ACCOUNT_SID=AC....
# TWILIO_AUTH_TOKEN=....
# TWILIO_FROM=+15105550000
# RESTAURANT_NOTIFY_PHONE=+15105550001

# Stripe (test keys for dev, live keys for production)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase service role key (server-only) — dish photo uploads to Storage
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google reviews (Places API) — homepage testimonials ─────────────────────
# Server key restricted to the Places API; place id from Places Text Search.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
